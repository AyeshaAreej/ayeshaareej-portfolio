<section class="hero-heading-left wf-section">
        <div class="container">
            <div class="hero-wrapper">
                <div class="hero-split">
                    {{#if @custom.hero_title }}
                    <h1 class="heading-2">{{@custom.hero_title}}</h1>
                    {{/if}}
                    {{#if @custom.hero_description }}
                    <p class="margin-bottom-24px">{{@custom.hero_description}}</p>
                    {{/if}}
                    {{#if @custom.hero_cta_url}}
                        <a href="{{@custom.hero_cta_url}}"
                        class="button-primary w-button">{{@custom.hero_cta_name}}</a>
                    {{/if}}
                </div>
                {{#if @site.cover_image}}
                <div class="hero-split hero-splite-two"><img
                        src="{{@site.cover_image}}"
                        loading="lazy" alt="" class="shadow-two"></div>
                </div>
                {{/if}}
        </div>
</section>
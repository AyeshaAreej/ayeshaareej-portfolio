
{{!-- {{#get "tags" limit="all"}}{{tags}}{{/get}} --}}

<div class="global-section">
<div class="global-wrap">
    <div class="tags-tabs">
        {{#get 'tags'}}
            {{#if tags}}
                <ul class="tags-list">
                    <li class="tag-item active" data-tag="all">
                        <span class="tag-link">All</span>
                    </li>
                    {{#foreach tags}}
                        <li class="tag-item" data-tag="{{slug}}">
                            <span class="tag-link">{{name}}</span>
                        </li>
                    {{/foreach}}
                </ul>
            {{else}}
                <p>{{t "No tags available"}}</p>
            {{/if}}
        {{/get}}
    </div>
</div>
</div>
<div class="loop-section global-section">
    <div id="loop-content" class="loop-wrap global-wrap global-flex">
        {{#foreach posts  }}
        <article class=" loop-item post-card global-flex global-aos{{#if @first}} is-double{{/if}}{{#if feature_image}} is-image{{/if}} {{post_class}}" data-aos="fade-up">
            {{> post_card index=@index }}
            <p style="color:aquamarine;"> djvjsd</p>
        </article>
        {{/foreach}}
        
    </div>
</div>


<script>
document.addEventListener('DOMContentLoaded', function() {
    const tagItems = document.querySelectorAll('.tag-item');
    const loopContent = document.getElementById('loop-content');
    let totalPostsLoaded = 0; // Track the total number of posts loaded

    function formatTagName(tagName) {
        const abbreviations = ['CRM', 'HR', 'IT', 'AI', 'API'];
        if (abbreviations.includes(tagName.toUpperCase())) {
            return tagName.toUpperCase();
        } else {
            return tagName
                .split(' ')
                .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
                .join(' ');
        }
    }

    tagItems.forEach(item => {
        const tagLink = item.querySelector('.tag-link');
        const originalTagName = tagLink.textContent.trim();
        tagLink.textContent = formatTagName(originalTagName);
    });

    tagItems.forEach(item => {
        item.addEventListener('click', function() {
            const tagSlug = this.getAttribute('data-tag');
            tagItems.forEach(tag => tag.classList.remove('active'));
            this.classList.add('active');
            totalPostsLoaded = 0; // Reset post count when fetching new tag
            fetchPosts(tagSlug);
        });
    });

    function fetchPosts(tag) {
        let url = `/ghost/api/v3/content/posts/?key=YOUR_CONTENT_API_KEY&limit=6&offset=${totalPostsLoaded}`;
        if (tag !== 'all') {
            url += `&filter=tags:${encodeURIComponent(tag)}`;
        }

        console.log('Fetching posts from:', url);

        fetch(url)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                console.log('Fetched posts:', data.posts);
                loopContent.innerHTML = ''; // Clear existing posts
                data.posts.forEach((post, index) => {
                    const postElement = createPostElement(post, totalPostsLoaded + index);
                    loopContent.appendChild(postElement);
                });
                totalPostsLoaded += data.posts.length; // Update the total count
                applyColorClasses(); // Apply color classes to newly added posts
            })
            .catch(error => {
                console.error('Error fetching posts:', error);
                loopContent.innerHTML = '<p>Failed to load posts. Please try again later.</p>';
            });
    }

   


});

</script>

<a href="{{url}}" class="global-link" aria-label="{{title}}"></a>
<div class="loop-content-wrap global-flex">
    <div  style="display: flex; flex-direction:column; width:100%">
        <div class="post-card-head header-color-{{@index}}">
            <div class="blog-left-box-inner">
                <div>
                    <div class="blog-left-box-inner-title" id="blog-id">
                        New SaaS Platforms {{@index}}
                    </div>

                    {{#if published_at}}
                    <div class="post-date ">
                      {{date published_at format="MMMM, YYYY"}}

                    </div>
                    {{/if}}
                </div>

                <!-- SVG icons  -->
                <div class="icon-grid">
                    <div class="icon-row">
                        <div class="icon-container"><img src="../assets/images/postHeaderIcons/image1.svg" alt="Icon 1" class="card-icon"/></div> 
                    </div>
                    <div class="icon-row">
                        <div class="icon-container"><img src="../assets/images/postHeaderIcons/image2.svg" alt="Icon 2" class="card-icon"/></div>
                        <div class="icon-container"> <img src="../assets/images/postHeaderIcons/image 3.svg" alt="Icon 3" class="card-icon"/></div>
                    </div>
                    <div class="icon-row">
                        <div class="icon-container"><img src="../assets/images/postHeaderIcons/image4.svg" alt="Icon 4" class="card-icon" /></div>
                        <div class="icon-container"><img src="../assets/images/postHeaderIcons/image5.svg" alt="Icon 5" class="card-icon" /></div> 
                         <div class="icon-container-last"><img src="../assets/images/postHeaderIcons/10 new.svg" alt="Icon 5" class="card-icon" /></div> 
                    </div>
                </div>
                <!-- End of SVG icons -->

            </div>
        </div>

        <div class="post-body">
            <div class="post-card-body-header">
                {{#if tags}}
                {{#foreach tags}}
                {{#if @first}}
                <div class="global-tags post-card-tag">
                    {{/if}}
                    {{/foreach}}
                    {{#foreach tags limit="3"}}
                    <a href="{{url}}">{{name}}</a>
                    {{/foreach}}
                    {{#foreach tags}}
                    {{#if @first}}
                </div>
                {{/if}}
                {{/foreach}}
                {{/if}}
            <span class="post-read-time">{{reading_time minute=(t "1 minute read") minutes=(t "% minutes read")}}</span>

                {{!-- <p class="post-read-time">24 min read</p> --}}
            </div>
            <h2 class="loop-title post-card-body-title"><a href="{{url}}">{{title}}</a><span>{{>icons/site/arrow}}</span></h2>
            {{#if custom_excerpt}}
            <div class="loop-excerpt post-card-body-description">
                {{{custom_excerpt}}}
            </div>
            {{/if}}
        </div>
    </div>
</div>

